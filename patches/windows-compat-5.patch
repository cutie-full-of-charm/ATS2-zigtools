diff --git a/libats/libc/DATS/fcntl.dats b/libats/libc/DATS/fcntl.dats
--- a/libats/libc/DATS/fcntl.dats
+++ b/libats/libc/DATS/fcntl.dats
@@ -52,14 +52,18 @@
 atstype_int
 atslib_libats_libc_fildes_iget_int
 (
   atstype_int fd
 ) {
+#if defined(_WIN32)
+  return atslib_libats_win_fildes_iget_int(fd);
+#else
   int flags ;
   flags = fcntl (fd, F_GETFD) ;
   if (flags < 0) return -1 ; // [fd2] not in use
   return fd ;
+#endif
 } // end of [atslib_libats_libc_fildes_iget_int]
 %}
 
