diff --git a/libats/libc/CATS/fcntl.cats b/libats/libc/CATS/fcntl.cats
--- a/libats/libc/CATS/fcntl.cats
+++ b/libats/libc/CATS/fcntl.cats
@@ -40,10 +40,15 @@
 
 /* ****** ****** */
 
 #include <sys/types.h>
 #include <fcntl.h> // HX: after sys/types
+#if defined(_WIN32)
+#include <io.h>
+extern int atslib_libats_win_fildes_iget_int(int fd);
+extern int atslib_libats_win_dup2_fildes(int fd, int dst);
+#endif
 
 /* ****** ****** */
 
 #define atslib_libats_libc_fildes_get_int(fd) (fd)
 
@@ -69,14 +74,21 @@
 #define \
 atslib_libats_libc_fcntl_setfl(fd, flags) fcntl(fd, F_SETFL, flags)
 
 /* ****** ****** */
 
+#if defined(_WIN32)
+#define \
+atslib_libats_libc_open_flags(path, flags) _open((char*)path, (flags) | _O_BINARY)
+#define \
+atslib_libats_libc_open_flags_mode(path, flags, mode) _open((char*)path, (flags) | _O_BINARY, mode)
+#else
 #define \
 atslib_libats_libc_open_flags(path, flags) open((char*)path, flags)
 #define \
 atslib_libats_libc_open_flags_mode(path, flags, mode) open((char*)path, flags, mode)
