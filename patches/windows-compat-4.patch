 /* ****** ****** */
 
+#if defined(_WIN32)
+#include <io.h>
+#include <direct.h>
+#include <process.h>
+#include <errno.h>
+#include <limits.h>
+#include <stddef.h>
+#include <stdint.h>
+static inline int atslib_libats_win_close(int fd) {
+  if (fd < 0) { errno = EBADF; return -1; }
+  return _close(fd);
+}
+
+static inline int atslib_libats_win_dup(int fd) {
+  if (fd < 0) { errno = EBADF; return -1; }
+  return _dup(fd);
+}
+
+static inline int atslib_libats_win_dup2(int fd, int dest) {
+  if (fd < 0 || dest < 0) { errno = EBADF; return -1; }
+  return _dup2(fd, dest) == 0 ? dest : -1;
+}
+
+static inline intptr_t atslib_libats_win_read(int fd, void *buf, size_t count) {
+  if (fd < 0) { errno = EBADF; return -1; }
+  if (count > INT_MAX) { errno = EINVAL; return -1; }
+  if (count != 0 && buf == NULL) { errno = EINVAL; return -1; }
+  return (intptr_t)_read(fd, buf, (unsigned int)count);
+}
+
+static inline intptr_t atslib_libats_win_write(int fd, const void *buf, size_t count) {
+  if (fd < 0) { errno = EBADF; return -1; }
+  if (count > INT_MAX) { errno = EINVAL; return -1; }
+  if (count != 0 && buf == NULL) { errno = EINVAL; return -1; }
+  return (intptr_t)_write(fd, buf, (unsigned int)count);
+}
+
+static inline char *atslib_libats_win_getcwd(char *buf, size_t size) {
+  if (buf == NULL) { errno = EINVAL; return NULL; }
+  if (size == 0 || size > INT_MAX) { errno = ERANGE; return NULL; }
+  char *result = _getcwd(buf, (int)size);
+  if (result != NULL) {
+    for (char *p = result; *p != '\0'; ++p) {
+      if (*p == '\\') *p = '/';
+    }
+  }
+  return result;
+}
