 %{$
 
+/* Windows absolute paths are not recognized by ATS2's POSIX-only check.
+ * Without this guard, C:\\... is prefixed with getcwd(), yielding
+ * C:/cwd/C:\\.../prelude/params.hats and fopen(EINVAL).
+ * Recognize drive-rooted, current-drive-rooted and UNC paths.  C:relative
+ * remains relative (as required by Win32 path semantics).
+ */
+ats_bool_type
+patsopt_filename_is_windows_absolute (ats_ptr_type name) {
+#ifdef _WIN32
+  const unsigned char *s = (const unsigned char *)name;
+  if (s[0] == '\\' || s[0] == '/') return ats_true_bool;
+  if (((s[0] >= 'A' && s[0] <= 'Z') ||
+       (s[0] >= 'a' && s[0] <= 'z')) &&
+      s[1] == ':' && (s[2] == '\\' || s[2] == '/'))
+    return ats_true_bool;
+#else
+  (void)name;
+#endif
+  return ats_false_bool;
+}
